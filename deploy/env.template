# Torn API configuration
TORN_API_KEY=your_torn_api_key_here
OUR_FACTION_ID=your_faction_id_here

# Google Sheets configuration
SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_CREDENTIALS_FILE=credentials.json

# Optional: Cloudflare R2 upload of the Status v2 JSON (travel_data.json)
# Set all four, or none to disable the JSON export
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET=gefunkt-data

# Optional: Environment and logging
ENV=production
LOGLEVEL=info
